PORT=5000
# Checkout uses transactions, so this MongoDB deployment must support replica sets (Atlas does).
MONGO_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0
# Test commands use this isolated database when provided. Its name must contain "test".
MONGO_URI_TEST=mongodb://localhost:27017/jontro_haat_test?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separate additional allowed origins. Trailing slashes are normalized.
FRONTEND_URL=http://localhost:5173,https://nexus-store-ecommerce.vercel.app
FLAT_SHIPPING_PRICE=10
TAX_RATE=0.08
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳
# Optional deterministic test-fixture credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPass123!
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPass123!
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
